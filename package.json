{
  "name": "centynella-mfe",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "CENTYNELLA-MFE: shell (host) de Module Federation para la administración y gestión de inventarios.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --mode sandbox",
    "build": "tsc -b && vite build --mode production",
    "build:sandbox": "tsc -b && vite build --mode sandbox",
    "build:production": "tsc -b && vite build --mode production",
    "preview": "vite preview --mode sandbox",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "node scripts/setup-hooks.mjs",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/poppins": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@module-federation/vite": "^1.22.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
