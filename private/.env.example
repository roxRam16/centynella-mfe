# ─────────────────────────────────────────────────────────────
# CENTYNELLA-MFE · plantilla de variables de entorno
#
# Copia este archivo según el ambiente y ajusta los valores:
#   private/.env.sandbox      -> ambiente de desarrollo (developer)
#   private/.env.production   -> producción
# Vite los lee vía `envDir: 'private'` según el --mode del comando.
# Los archivos reales están en .gitignore: NUNCA se versionan.
#
# ⚠ Todo lo que empieza con VITE_ termina dentro del bundle público.
#   No guardes secretos aquí.
# ─────────────────────────────────────────────────────────────

# Nombre visible de la aplicación
VITE_APP_NAME=CENTYNELLA

# Ambiente: sandbox | production
VITE_APP_ENV=sandbox

# URL base de CENTYNELLA-CORE (backend FastAPI), sin "/" final
VITE_API_BASE_URL=http://localhost:8000

# Microfrontends remotos (Module Federation), separados por coma.
# Formato: nombre@urlDelRemoteEntry
# Ejemplo: inventory@http://localhost:5174/remoteEntry.js,orders@http://localhost:5175/remoteEntry.js
VITE_REMOTES=
